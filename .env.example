# Scaleway Object Storage voor de video's op de site (bucket preludens-website-content, fr-par).
# Kopieer naar .env en vul een Scaleway API-key in met schrijfrechten op de bucket
# (console.scaleway.com → IAM → API keys). Gebruikt door bin/upload-video.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_BUCKET=preludens-website-content
SCW_REGION=fr-par
SCW_ENDPOINT=https://s3.fr-par.scw.cloud
