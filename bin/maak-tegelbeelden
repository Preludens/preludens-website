#!/usr/bin/env bash
#
# Maakt voor elk screenshot in assets/images/verhalen/ dat als `image:` in een
# verhaal staat een tegelversie van precies 16:9: <naam>-tegel.jpg.
#
# Waarom: de glasvlakken van de vier cinematische kaders op /inspiratie/ zijn
# allemaal 16:9, maar de bronbeelden lopen van 1,33 tot 2,67 breed. Bijsnijden
# tot 16:9 zou UI kosten, en contain laat een zwarte balk achter. Dit script
# vult het beeld daarom op tot 16:9 door de randrij of -kolom door te trekken en
# zacht te laten uitlopen naar de gemiddelde randkleur — bij een UI met een
# vlakke balk boven en onder is dat niet te zien. Alleen als die band breder dan
# 22% zou worden, wordt er eerst bijgesneden, en dan op de plek met de minste
# beeldinformatie.
#
# Het origineel blijft staan; alleen de -tegel.jpg wordt (opnieuw) gemaakt. De
# tegel wordt vanzelf gebruikt zodra hij bestaat (zie _includes/strip-tile.html).
#
# Gebruik:  ./bin/maak-tegelbeelden [bestandsnaam ...]
# Zonder argumenten worden alle `image:`-beelden uit _verhalen/ gedaan.

set -euo pipefail

cd "$(dirname "$0")/.."
ROOT="$PWD"
DIR="$ROOT/assets/images/verhalen"
HELPER="$ROOT/bin/lib/tegelbeeld.js"

for cmd in ffmpeg ffprobe node; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "maak-tegelbeelden: $cmd ontbreekt" >&2; exit 1; }
done

if [ "$#" -gt 0 ]; then
  files=("$@")
else
  files=()
  while IFS= read -r naam; do
    [ -n "$naam" ] && files+=("$naam")
  done < <(grep -h '^image:' "$ROOT"/_verhalen/*.md | sed 's/^image:[[:space:]]*//' | tr -d '"' | sort -u)
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

for file in "${files[@]}"; do
  case "$file" in */*|*://*) echo "overgeslagen (geen los bestand): $file"; continue;; esac
  [ -f "$DIR/$file" ] || { echo "overgeslagen (niet gevonden): $file"; continue; }
  base="${file%.*}"

  dims="$(ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv "$DIR/$file")"
  w="$(echo "$dims" | cut -d, -f2)"
  h="$(echo "$dims" | cut -d, -f3)"
  tw="$w"; th="$h"
  if [ "$w" -gt 1800 ]; then
    tw=1800
    th=$(( (h * 1800 + w / 2) / w ))
  fi

  ffmpeg -y -v error -i "$DIR/$file" -vf "scale=$tw:$th" -f rawvideo -pix_fmt rgba "$tmp/in.rgba"
  printf '%-36s ' "$base"
  node "$HELPER" "$tmp/in.rgba" "$tw" "$th" "$tmp/uit.rgba" 1600 900
  ffmpeg -y -v error -f rawvideo -pix_fmt rgba -s 1600x900 -i "$tmp/uit.rgba" -q:v 4 "$DIR/$base-tegel.jpg"
done

echo "klaar"
